# Salin menjadi .env lalu ubah nilainya sebelum `docker compose up -d --build`.

# Password database. Gunakan huruf & angka saja (dipakai di dalam URL koneksi).
# Catatan: hanya berlaku saat database dibuat pertama kali (volume masih kosong).
POSTGRES_PASSWORD=ganti-password-db

# Akun admin pertama (dibuat otomatis saat aplikasi start jika belum ada).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-password-admin
ADMIN_NAME=Administrator

# Port aplikasi di server.
APP_PORT=3000

# Kosongkan bila di belakang reverse proxy HTTPS (nginx/caddy/traefik) atau diakses via HTTP biasa.
# Isi true bila aplikasi langsung melayani HTTPS tanpa reverse proxy.
COOKIE_SECURE=
